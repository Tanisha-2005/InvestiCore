# Server Setup
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Replace <username> and <password> with your MongoDB credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/investicore?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_token_here
JWT_EXPIRES_IN=7d

# OpenAI Integration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Threat Intelligence Live APIs (Optional - Replace with your API keys)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
ALIENVAULT_OTX_API_KEY=your_alienvault_api_key_here

# File Storage (Options: 'local' or 's3')
STORAGE_MODE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
